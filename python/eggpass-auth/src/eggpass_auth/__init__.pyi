from typing import Optional, Sequence

class EggpassAuthError(Exception): ...
class InvalidConfigurationError(EggpassAuthError): ...
class InvalidResponseError(EggpassAuthError): ...
class HttpStatusError(EggpassAuthError):
    status: int
class OAuthError(EggpassAuthError):
    status: int
    code: str
class ProviderDeniedError(EggpassAuthError):
    code: str
class CallbackMismatchError(EggpassAuthError): ...
class StateMismatchError(EggpassAuthError): ...
class NonceMismatchError(EggpassAuthError): ...
class ResponseTooLargeError(EggpassAuthError): ...
class TransportError(EggpassAuthError): ...
class OperationTimeoutError(EggpassAuthError): ...
class UnsupportedOperationError(EggpassAuthError): ...
class DeviceExpiredError(EggpassAuthError): ...
class OperationCancelledError(EggpassAuthError): ...
class UntrustedVerificationUrlError(EggpassAuthError): ...
class NotLoggedInError(EggpassAuthError): ...
class NoRefreshTokenError(EggpassAuthError): ...
class CredentialStorageError(EggpassAuthError): ...

class ProviderProfile:
    @staticmethod
    def xai() -> ProviderProfile: ...
    @staticmethod
    def xai_compatibility_fallback() -> ProviderProfile: ...
    @staticmethod
    def openai(host_id: Optional[str] = ...) -> ProviderProfile: ...
    @staticmethod
    def custom(display_name: str, issuer: str, client_id: str) -> ProviderBuilder: ...
    @property
    def display_name(self) -> str: ...
    @property
    def issuer(self) -> str: ...
    @property
    def callback_path(self) -> str: ...
    @property
    def scopes(self) -> list[str]: ...
    @property
    def client_id_policy(self) -> str: ...

class ProviderBuilder:
    def authorization_endpoint(self, value: str) -> None: ...
    def token_endpoint(self, value: str) -> None: ...
    def device_authorization_endpoint(self, value: str) -> None: ...
    def userinfo_endpoint(self, value: str) -> None: ...
    def revocation_endpoint(self, value: str) -> None: ...
    def callback_path(self, value: str) -> None: ...
    def scopes(self, values: Sequence[str]) -> None: ...
    def client_id_policy(self, value: str) -> None: ...
    def authorization_parameter(self, name: str, value: str) -> None: ...
    def registration_parameter(self, name: str, value: str) -> None: ...
    def token_parameter(self, name: str, value: str) -> None: ...
    def device_parameter(self, name: str, value: str) -> None: ...
    def trusted_device_hosts(self, hosts: Sequence[str]) -> None: ...
    def build(self) -> ProviderProfile: ...

class OAuthClient:
    def __init__(self, profile: ProviderProfile, timeout_seconds: int = ..., max_response_body_bytes: int = ...) -> None: ...
    @property
    def provider(self) -> ProviderProfile: ...
    def begin_authorization(self, redirect_uri: str, existing: Optional[Credentials] = ...) -> PendingAuthorization: ...
    async def complete_authorization(self, pending: PendingAuthorization, callback_url: str) -> Credentials: ...
    async def complete_authorization_with_code(self, pending: PendingAuthorization, code: str) -> Credentials: ...
    async def exchange_authorization_code(self, code: str, redirect_uri: str, code_verifier: str, client_id: Optional[str] = ...) -> Credentials: ...
    async def refresh_token(self, refresh_token: str, client_id: Optional[str] = ...) -> TokenSet: ...
    async def refresh_credentials(self, credentials: Credentials) -> Credentials: ...
    async def revoke(self, token: str, client_id: Optional[str] = ...) -> None: ...
    async def userinfo(self, access_token: str) -> UserInfo: ...
    async def request_device_code(self) -> DeviceCode: ...
    async def poll_device_code(self, device: DeviceCode) -> DevicePoll: ...
    async def poll_device_authorization(self, device: DeviceCode, cancellation: Optional[CancellationToken] = ..., timeout_seconds: int = ...) -> Credentials: ...

class PendingAuthorization:
    @property
    def authorization_url(self) -> str: ...
    @property
    def consumed(self) -> bool: ...

class Credentials:
    @property
    def access_token(self) -> str: ...
    @property
    def refresh_token(self) -> Optional[str]: ...
    @property
    def id_token(self) -> Optional[str]: ...
    @property
    def token_type(self) -> str: ...
    @property
    def scope(self) -> Optional[str]: ...
    @property
    def client_id(self) -> str: ...
    @property
    def issuer(self) -> str: ...
    @property
    def expires_at(self) -> Optional[int]: ...
    @property
    def obtained_at(self) -> int: ...
    def is_fresh(self, now_unix: Optional[int] = ..., skew_seconds: int = ...) -> bool: ...
    def to_json(self) -> str: ...
    @staticmethod
    def from_json(serialized: str) -> Credentials: ...

class TokenSet:
    @property
    def access_token(self) -> str: ...
    @property
    def refresh_token(self) -> Optional[str]: ...
    @property
    def id_token(self) -> Optional[str]: ...
    @property
    def token_type(self) -> str: ...
    @property
    def scope(self) -> Optional[str]: ...
    @property
    def expires_at(self) -> Optional[int]: ...

class DeviceCode:
    @property
    def user_code(self) -> str: ...
    @property
    def verification_uri(self) -> str: ...
    @property
    def verification_uri_complete(self) -> Optional[str]: ...
    @property
    def expires_in_seconds(self) -> float: ...
    @property
    def interval_seconds(self) -> float: ...

class DevicePoll:
    @property
    def status(self) -> str: ...
    @property
    def tokens(self) -> Optional[TokenSet]: ...

class UserInfo:
    @property
    def user_id(self) -> Optional[str]: ...
    @property
    def email(self) -> Optional[str]: ...

class CancellationToken:
    def __init__(self) -> None: ...
    def cancel(self) -> None: ...
    @property
    def is_cancelled(self) -> bool: ...
